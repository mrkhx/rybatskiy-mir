# Скопируйте в .env и при необходимости измените значения.
# Файл .env не коммитится. Production secrets в GitHub не хранятся.

NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=rybatskiy
POSTGRES_PASSWORD=rybatskiy
POSTGRES_DB=rybatskiy_mir
DATABASE_URL=postgresql://rybatskiy:rybatskiy@localhost:5432/rybatskiy_mir

# Redis
REDIS_URL=redis://localhost:6379

# JWT (замените перед любым не-local запуском)
JWT_SECRET=change-me-local-dev-only
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Только для локальной разработки. В production игнорируется/запрещён.
ALLOW_DEV_AUTH=true

# VK Mini Apps / VK ID.
# Оставьте пустыми до появления реального приложения VK.
# Секрет никогда не должен попадать во frontend-бандл.
VK_APP_ID=
VK_APP_SECRET=
VK_API_VERSION=5.199

# Frontend / Admin (Vite, подставляются на этапе сборки)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
VITE_ADMIN_API_URL=http://localhost:3000
