# Staging example. Copy to .env.staging on the server. Never commit the real file.
# Generate passwords with: openssl rand -base64 32
# Use URL-safe values (A-Za-z0-9-_+) so DATABASE_URL / REDIS_URL stay valid.

NODE_ENV=production
IMAGE_TAG=staging
HTTP_PORT=80

# Public origin used by the browser (no trailing slash).
PUBLIC_URL=http://STAGING_HOST_PLACEHOLDER
FRONTEND_ORIGIN=http://STAGING_HOST_PLACEHOLDER
ADMIN_ORIGIN=http://STAGING_HOST_PLACEHOLDER

POSTGRES_USER=rybatskiy
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=rybatskiy_mir

REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD

JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

ALLOW_DEV_AUTH=false

VK_APP_ID=
VK_APP_SECRET=
VK_API_VERSION=5.199

# Optional image overrides (defaults: ghcr.io/mrkhx/rybatskiy-mir-*).
# BACKEND_IMAGE=ghcr.io/mrkhx/rybatskiy-mir-backend
# FRONTEND_IMAGE=ghcr.io/mrkhx/rybatskiy-mir-frontend
# ADMIN_IMAGE=ghcr.io/mrkhx/rybatskiy-mir-admin
# PROXY_IMAGE=ghcr.io/mrkhx/rybatskiy-mir-proxy
