# Copy to the VPS as /opt/rybatskiy-mir/.env.staging
# Never commit the real file. Generate secrets ON THE SERVER:
#   openssl rand -hex 32
# Hex is URL-safe (required: passwords are interpolated into DATABASE_URL / REDIS_URL).

NODE_ENV=production
ALLOW_DEV_AUTH=false
IMAGE_TAG=staging
HTTP_PORT=80

# Browser origin, no trailing slash. First staging (no domain): http://<PUBLIC_IP>
# Must match what the user types in the address bar (CORS).
PUBLIC_URL=http://STAGING_PUBLIC_IP
FRONTEND_ORIGIN=http://STAGING_PUBLIC_IP
ADMIN_ORIGIN=http://STAGING_PUBLIC_IP

POSTGRES_USER=rybatskiy
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=rybatskiy_mir

REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Backend JWT. loadEnv requires length >= 32 when NODE_ENV=production.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=7d

# Empty until a real VK Mini App exists. Secret never goes to frontend images.
VK_APP_ID=
VK_APP_SECRET=
VK_API_VERSION=5.199

# Assembled by docker-compose.staging.yml from POSTGRES_* / REDIS_PASSWORD
# (hosts are the compose service names `postgres` and `redis`, not localhost):
#   DATABASE_URL=postgresql://rybatskiy:<POSTGRES_PASSWORD>@postgres:5432/rybatskiy_mir
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
